---
layout: base.njk
---
<div class="wrap actu-detail" style="padding-top:56px; padding-bottom:100px;">
  <a href="/actualites/" class="back-btn" style="display:inline-block; margin-bottom:32px;">&larr; {{ site.actualites.back_link }}</a>

  <div class="actu-meta">{{ date | dateFr }}</div>
  <h1 class="actu-title">{{ title }}</h1>

  {% if photo_couverture %}
  <div class="actu-cover">
    <img src="{{ photo_couverture }}" alt="{{ title }}">
  </div>
  {% endif %}

  <div class="actu-body">
    {{ content | safe }}
  </div>

  {% if photos.length > 0 %}
  <div class="actu-gallery">
    {% for ph in photos %}
    <div class="actu-gallery-item">
      <img src="{{ ph.image }}" alt="{{ ph.legende or title }}">
      {% if ph.legende %}<div class="actu-gallery-caption">{{ ph.legende }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
